{
  "channelsEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "disableClaudeAiConnectors": true,
  "permissions": {
    "denyInsteadOfPrompting": true,
    "additionalDirectories": ["/data/config/channels/telegram/inbox"],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(//data/config/.credentials.json)",
      "Read(//data/ssh/**)",
      "Edit(//data/ssh/**)",
      "Edit(//data/settings)",
      "Edit(//data/config/settings.json)",
      "Edit(//data/config/.claude.json)",
      "Edit(//data/config/.credentials.json)",
      "Edit(//data/config/channels/**)",
      "Edit(//data/config/plugins/**)",
      "Edit(//etc/claude-code/**)",
      "Read(//proc/**)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)"
    ],
    "allow": [
      "ToolSearch",
      "mcp__plugin_telegram_telegram__reply",
      "mcp__plugin_telegram_telegram__react",
      "mcp__plugin_telegram_telegram__edit_message",
      "mcp__plugin_telegram_telegram__download_attachment"
    ]
  },
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Never read, print or send credentials: environment variables holding tokens or keys (CLAUDE_CODE_OAUTH_TOKEN, ANTHROPIC_API_KEY, TELEGRAM_BOT_TOKEN), any .env file, .credentials.json or /proc/*/environ. This includes sending them in a Telegram reply, a file, a URL or a request to any host."
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "date '+The current date and time is %A %Y-%m-%d %H:%M %Z.'; jq -r 'select(.ok) | .result | \"You are the Telegram bot @\\(.username) (shown as \\(.first_name)), id \\(.id). Answer to that name.\"' /data/config/channels/telegram/me.json 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /data/audit.jsonl",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "authentication_failed|billing_error|account_on_hold|oauth_org_not_allowed",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "e=$(jq -r .error); . /data/config/channels/telegram/.env; curl -fsS -m 10 \"https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage\" -d chat_id=\"$OWNER_TELEGRAM_ID\" --data-urlencode text=\"⚠️ Agent stopped: $e. Check the credential.\" >/dev/null"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "m=$(jq -r .message); . /data/config/channels/telegram/.env; curl -fsS -m 10 \"https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/sendMessage\" -d chat_id=\"$OWNER_TELEGRAM_ID\" --data-urlencode text=\"⏸ Agent is waiting for a permission: $m\" >/dev/null"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /data/audit.jsonl",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat >> /data/audit.jsonl",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "promptSuggestionEnabled": false
}
